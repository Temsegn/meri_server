# ── Runtime ──
NODE_ENV=development
PORT=4000
# Public URL of the Next.js client (used for CORS and links in emails)
CLIENT_URL=http://localhost:3000

# ── Database (docker compose: postgres on 5433) ──
DATABASE_URL=postgresql://meriboost:meriboost@localhost:5433/meriboost?schema=public
# Direct (non-pooled) connection for migrations; same as DATABASE_URL locally
DIRECT_URL=postgresql://meriboost:meriboost@localhost:5433/meriboost?schema=public

# ── Auth ──
# Long random string: `openssl rand -base64 48`
JWT_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
SESSION_TTL_DAYS=30
# true in production (HTTPS only)
COOKIE_SECURE=false

# ── Object storage: Cloudflare R2 (S3 API) ──
# Production R2:  S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
# Dev (s3mock from docker compose):
S3_ENDPOINT=http://localhost:9090
S3_REGION=auto
S3_BUCKET=meriboost-receipts
S3_ACCESS_KEY_ID=meriboost
S3_SECRET_ACCESS_KEY=dev-secret
# Create the bucket on boot if missing (dev only; create it in the R2 dashboard for prod)
S3_CREATE_BUCKET=true

# ── Email (leave SMTP_URL empty to log emails to the console) ──
# Dev mailpit: smtp://localhost:1025
SMTP_URL=smtp://localhost:1025
MAIL_FROM="MeriBoost <no-reply@meriboost.local>"

# ── Seed ──
ADMIN_EMAIL=admin@meriboost.local
ADMIN_PASSWORD=change-me-admin
ADMIN_NAME="MeriBoost Admin"
# Adds sample delivery emails and marketplace listings
SEED_DEMO=true
# Password for the demo customer accounts (ava@demo.meriboost.local …)
DEMO_PASSWORD=Demo-password-1

# ── Google sign-in (optional) ──
# Redirect URI to register for local dev: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
